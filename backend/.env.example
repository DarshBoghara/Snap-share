# Application Settings
PROJECT_NAME="SnapChat Clone"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-jwt-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=snapchat_chat
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/snapchat_chat

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# ==========================================
# SNAPSHARE PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# Application Settings
PROJECT_NAME="SNAPSHARE"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-32-character-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=snapshare_user
POSTGRES_PASSWORD=generate_secure_db_password_here
POSTGRES_DB=snapshare_db
DATABASE_URL=postgresql+asyncpg://snapshare_user:generate_secure_db_password_here@postgres:5432/snapshare_db

# Redis Cache & Pub/Sub
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# CORS & Domain Settings
CORS_ORIGINS=["http://localhost:5173", "http://localhost", "https://yourdomain.com"]

# Frontend Configuration (Injected into Vite build)
VITE_API_BASE_URL="/api/v1"
VITE_WS_URL=""
